APP_NAME=Intelligent School Monitoring System
APP_ENV=development
API_V1_STR=/api/v1
VIDEO_LOG_DIR=./video_logs
VIDEO_TTL_HOURS=72
# SQLAlchemy URL. SQLite by default; switch to PostgreSQL by changing the URL
# (and installing a driver, e.g. `pip install "psycopg[binary]"`):
#   DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/schoolsmarteye
DATABASE_URL=sqlite:///./schoolsmarteye.db
DB_AUTO_CREATE=true

# ── Authentication ───────────────────────────────────────────────────────────
# Generate a real secret with: openssl rand -hex 32
# The app refuses to start with this placeholder when APP_ENV=production.
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Demo users (teacher / principal / ministry) are created when the users table is empty.
# Override the passwords below; in production demo users are NOT created with the defaults.
SEED_DEMO_USERS=true
DEMO_TEACHER_PASSWORD=teacher123
DEMO_PRINCIPAL_PASSWORD=principal123
DEMO_MINISTRY_PASSWORD=ministry123

# Comma-separated list of allowed browser origins (CORS)
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# ── Native AI Engine (OpenAI-compatible endpoints; no Ollama dependency) ─────
# Hybrid tries the cloud endpoint first, then local inference if cloud is unavailable.
# Cloud endpoint must use HTTPS. Configure only aggregate, non-identifying metrics.
AI_PROVIDER=hybrid
AI_REQUEST_TIMEOUT_SECONDS=45
AI_CLOUD_BASE_URL=https://your-cloud-provider.example/v1
AI_CLOUD_MODEL=your-high-capability-model
AI_CLOUD_API_KEY=
# Example local llama.cpp server: http://127.0.0.1:8081/v1
AI_LOCAL_BASE_URL=http://127.0.0.1:8081/v1
AI_LOCAL_MODEL=your-local-model
AI_LOCAL_API_KEY=
